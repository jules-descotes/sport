# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Sport
APP_VERSION=0.1.0
DEBUG=False

# ── Base de données ───────────────────────────────────────────────────────────
# Railway fournit un DATABASE_URL en postgresql:// — config.py le convertit
# automatiquement en postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sport

# ── Auth (un seul utilisateur, créé au démarrage) ─────────────────────────────
SECRET_KEY=GENERER_256_BITS_ALEATOIRE
ADMIN_EMAIL=jules@atelier-okomi.fr
ADMIN_PASSWORD=CHANGER
ACCESS_TOKEN_EXPIRE_DAYS=60
SESSION_COOKIE_NAME=sport_session
# À laisser vide : le cookie reste lié à api-sport.atelier-okomi.fr, seul hôte
# que le front appelle. Ne renseigner ".atelier-okomi.fr" que si un jour un
# autre sous-domaine doit lire la session.
SESSION_COOKIE_DOMAIN=

# ── Hôte unique, déclaré partout ──────────────────────────────────────────────
SITE_URL=https://sport.atelier-okomi.fr

# ── Stockage des photos (lot 2+) ──────────────────────────────────────────────
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sport-media
R2_PUBLIC_URL=

# ── Emails et supervision ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAILS_FROM=bonjour@atelier-okomi.fr
SENTRY_DSN=

# ── Sources externes (lot 1) ──────────────────────────────────────────────────
WINDY_WEBCAMS_API_KEY=
TIDES_API_KEY=
FORECAST_INGEST_INTERVAL_HOURS=3

# Open-Meteo : gratuit et sans clé en usage non commercial. Toutes ces valeurs
# ont une valeur par défaut dans config.py — ne les poser en environnement que
# pour corriger un changement d'API sans redéployer.
# OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPENMETEO_ARCHIVE_URL=https://historical-forecast-api.open-meteo.com/v1/forecast

# ⚠️ NE JAMAIS changer de modèle de vagues en cours de route : un biais constant
# s'annule dans l'apprentissage, un biais qui change casse tout l'historique.
FORECAST_WAVE_MODEL=meteofrance_wave
# Écrite sur chaque ligne de `forecasts`. À incrémenter à la main le jour où
# Météo-France recalibre MFWAM : c'est la seule trace qui permettra de segmenter
# l'historique d'apprentissage avant / après.
FORECAST_MODEL_VERSION=mfwam-2025

# Cache des spots « potentiels », en heures.
FORECAST_CACHE_HOURS=3
# Plafond dur d'appels par passe d'ingestion.
FORECAST_CALL_CAP=600
# Au-delà, l'écran est servi depuis la base et le reste se complète derrière.
FORECAST_ON_DEMAND_TIMEOUT_S=5

# Overpass — interrogé uniquement par `scripts/import_osm_spots.py`, jamais
# depuis l'API.
OVERPASS_URL=https://overpass-api.de/api/interpreter
