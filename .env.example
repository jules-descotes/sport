# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Sport
APP_VERSION=0.1.0
DEBUG=False

# ── Base de données ───────────────────────────────────────────────────────────
# Railway fournit un DATABASE_URL en postgresql:// — config.py le convertit
# automatiquement en postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sport

# ── Auth (un seul utilisateur, créé au démarrage) ─────────────────────────────
SECRET_KEY=GENERER_256_BITS_ALEATOIRE
ADMIN_EMAIL=jules@atelier-okomi.fr
ADMIN_PASSWORD=CHANGER
ACCESS_TOKEN_EXPIRE_DAYS=60
SESSION_COOKIE_NAME=sport_session
# À laisser vide : le cookie reste lié à api-sport.atelier-okomi.fr, seul hôte
# que le front appelle. Ne renseigner ".atelier-okomi.fr" que si un jour un
# autre sous-domaine doit lire la session.
SESSION_COOKIE_DOMAIN=

# ── Hôte unique, déclaré partout ──────────────────────────────────────────────
SITE_URL=https://sport.atelier-okomi.fr

# ── Stockage des photos (lot 2+) ──────────────────────────────────────────────
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sport-media
R2_PUBLIC_URL=

# ── Emails et supervision ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAILS_FROM=bonjour@atelier-okomi.fr
SENTRY_DSN=

# ── Sources externes (lot 1) ──────────────────────────────────────────────────
WINDY_WEBCAMS_API_KEY=
TIDES_API_KEY=
FORECAST_INGEST_INTERVAL_HOURS=3
