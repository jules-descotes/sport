# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Sport
APP_VERSION=0.1.0
DEBUG=False

# ── Base de données ───────────────────────────────────────────────────────────
# Railway fournit un DATABASE_URL en postgresql:// — config.py le convertit
# automatiquement en postgresql+asyncpg://.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/sport

# ── Auth (un seul utilisateur, créé au démarrage) ─────────────────────────────
SECRET_KEY=GENERER_256_BITS_ALEATOIRE
ADMIN_EMAIL=jules@atelier-okomi.fr
ADMIN_PASSWORD=CHANGER
ACCESS_TOKEN_EXPIRE_DAYS=60
SESSION_COOKIE_NAME=sport_session
# À laisser vide : le cookie reste lié à api-sport.atelier-okomi.fr, seul hôte
# que le front appelle. Ne renseigner ".atelier-okomi.fr" que si un jour un
# autre sous-domaine doit lire la session.
SESSION_COOKIE_DOMAIN=
# Jeton Bearer du raccourci iPhone (lot 2). Un an : il vit dans les Raccourcis
# iOS et on ne veut pas le refaire tous les deux mois. C'est long, et c'est
# précisément pour ça qu'il est révocable depuis le profil — la table
# `api_tokens` porte un `jti` par jeton, et le couper n'exige pas de changer
# SECRET_KEY (ce qui déconnecterait aussi le navigateur).
API_TOKEN_EXPIRE_DAYS=365

# ── Hôte unique, déclaré partout ──────────────────────────────────────────────
SITE_URL=https://sport.atelier-okomi.fr

# ── Stockage des photos de session (lot 2) ────────────────────────────────────
# `local` écrit sous MEDIA_DIR et sert les fichiers sur /media (développement
# seulement : le disque du conteneur Railway est éphémère). `r2` est le mode de
# production. Les photos sont ré-encodées en JPEG 1600 px avant stockage, ce qui
# efface au passage l'EXIF — GPS compris.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sport-media
R2_PUBLIC_URL=

# ── Emails et supervision ─────────────────────────────────────────────────────
RESEND_API_KEY=
EMAILS_FROM=bonjour@atelier-okomi.fr
SENTRY_DSN=

# ── Sources externes (lot 1) ──────────────────────────────────────────────────
WINDY_WEBCAMS_API_KEY=
TIDES_API_KEY=
FORECAST_INGEST_INTERVAL_HOURS=3

# Open-Meteo : gratuit et sans clé en usage non commercial. Toutes ces valeurs
# ont une valeur par défaut dans config.py — ne les poser en environnement que
# pour corriger un changement d'API sans redéployer.
# OPENMETEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
# OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPENMETEO_ARCHIVE_URL=https://historical-forecast-api.open-meteo.com/v1/forecast

# ⚠️ NE JAMAIS changer de modèle de vagues en cours de route : un biais constant
# s'annule dans l'apprentissage, un biais qui change casse tout l'historique.
FORECAST_WAVE_MODEL=meteofrance_wave
# Écrite sur chaque ligne de `forecasts`. À incrémenter à la main le jour où
# Météo-France recalibre MFWAM : c'est la seule trace qui permettra de segmenter
# l'historique d'apprentissage avant / après.
FORECAST_MODEL_VERSION=mfwam-2025

# Cache des spots « potentiels », en heures.
FORECAST_CACHE_HOURS=3
# Plafond dur d'appels par passe d'ingestion.
FORECAST_CALL_CAP=600
# Au-delà, l'écran est servi depuis la base et le reste se complète derrière.
FORECAST_ON_DEMAND_TIMEOUT_S=5

# Overpass — interrogé uniquement par `scripts/import_osm_spots.py`, jamais
# depuis l'API.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ── Webcams (décidé le 13/09, retours n° 4) ────────────────────────────────
#
# Hôtes supplémentaires autorisés en iframe, séparés par des virgules. Ils
# **s'ajoutent** aux défauts de `frontend/lib/webcam-hosts.ts` : une variable
# mal écrite ne retire jamais les webcams qui marchent.
#
# Un point en tête vaut « ce domaine et tous ses sous-domaines ».
# Côté Vercel, la variable s'appelle NEXT_PUBLIC_WEBCAM_FRAME_HOSTS — elle est
# lue au build (pour la CSP) et dans le navigateur (pour décider iframe ou
# lien sortant), et une variable serveur ne serait visible que d'un des deux.
NEXT_PUBLIC_WEBCAM_FRAME_HOSTS=

# ── CANDHIS — bouées du Cerema (lot 1 bis, décidé le 15/09) ────────────────
#
# Aucun défaut, et c'est volontaire : sans clé, la fonctionnalité s'éteint
# proprement et le démarrage le dit. Une valeur bidon ferait quarante appels
# à 401 par jour. La clé vit en variable Railway, jamais dans le dépôt.
CANDHIS_API_KEY=
CANDHIS_URL=https://candhis.cerema.fr/API/v1

# Quota accordé avec le jeton : 150 requêtes par jour. On s'arrête à 140, et
# le compteur est **persisté en base** (`api_quota`) parce que le conteneur
# Railway redémarre. Leur documentation prévoit un 429 au dépassement et un
# 423 quand une IP est bannie — on n'attend pas d'y arriver.
CANDHIS_DAILY_CALL_CAP=140

# ⚠️ Le fuseau des horodatages CANDHIS n'est PAS documenté par le Cerema
# (cf. docs/CANDHIS.md §5). UTC est la convention des archives
# océanographiques et celle du reste de la base. Cette variable existe pour
# corriger sans redéployer si la mesure dit le contraire — un décalage d'une
# heure se verra dans la table de calibration avant de se voir à l'écran.
CANDHIS_TZ=UTC

# Le job horaire : ~24 requêtes par jour, loin sous le plafond.
CANDHIS_INGEST_INTERVAL_HOURS=1

# Au-delà, une bouée ne décrit plus le même plan d'eau : le spot n'en reçoit
# aucune plutôt qu'une lointaine.
OBSERVATION_STATION_MAX_KM=30
